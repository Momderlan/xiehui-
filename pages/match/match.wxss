/* pages/match/match.wxss */

.page {
  min-height: 100vh;
  background-color: #F9FAFB;
}

.container {
  padding: 20rpx;
  box-sizing: border-box;
}

/* ========== 页面标题 ========== */
.page-header {
  margin-bottom: 24rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #111827;
  margin-bottom: 8rpx;
  line-height: 1.2;
}

.page-desc {
  font-size: 26rpx;
  color: #6B7280;
}

/* ========== 赛事列表 - 三段式结构 ========== */
.match-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.match-item {
  padding: 24rpx;
  transition: all 0.2s;
}

.match-item:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

/* 第一行：标题 + 状态标签 */
.match-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.match-title {
  flex: 1;
  font-size: 32rpx;
  font-weight: 600;
  color: #111827;
  line-height: 1.4;
}

.match-status {
  flex-shrink: 0;
  margin-top: 4rpx;
}

/* 第二行：时间和地点 */
.match-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.info-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.info-icon {
  font-size: 24rpx;
  width: 32rpx;
  text-align: center;
}

.info-text {
  font-size: 26rpx;
  color: #6B7280;
  line-height: 1.5;
}

/* 第三行：截止时间 + 操作入口 */
.match-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 16rpx;
  border-top: 1rpx solid #F3F4F6;
}

.deadline-text {
  font-size: 24rpx;
  color: #9CA3AF;
}

.action-link {
  font-size: 26rpx;
  color: #F97316;
  font-weight: 500;
}

/* ========== 空状态 ========== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
  opacity: 0.3;
}

.empty-text {
  font-size: 28rpx;
  color: #9CA3AF;
}