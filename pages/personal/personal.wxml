<!--pages/personal/personal.wxml-->
<view class="page">
  <view class="container">
    
    <!-- 用户信息卡片 -->
    <view class="user-card card">
      <image src="{{userInfo.avatar}}" class="user-avatar" mode="aspectFill"></image>
      <view class="user-info">
        <view class="user-name">{{userInfo.name}}</view>
        <view class="user-level" style="color: {{themeColor}}">{{userInfo.memberLevel}}</view>
        <view class="user-points">积分：{{userInfo.points}}</view>
      </view>
    </view>

    <!-- 功能列表 -->
    <view class="menu-card card">
      <view class="menu-item" bindtap="onMyMatchTap">
        <view class="menu-left">
          <view class="menu-icon">📋</view>
          <view class="menu-title">我的赛事</view>
        </view>
        <view class="menu-arrow">→</view>
      </view>

      <view class="menu-item" bindtap="onMyClubTap">
        <view class="menu-left">
          <view class="menu-icon">🏢</view>
          <view class="menu-title">我的俱乐部</view>
        </view>
        <view class="menu-arrow">→</view>
      </view>

      <view class="menu-item" bindtap="onNotificationTap">
        <view class="menu-left">
          <view class="menu-icon">📢</view>
          <view class="menu-title">官方通知</view>
        </view>
        <view class="menu-arrow">→</view>
      </view>
    </view>

    <!-- 退出登录按钮 -->
    <view class="logout-card card">
      <view class="logout-btn" bindtap="onLogout">
        <view class="logout-icon">🚪</view>
        <view class="logout-text">退出登录</view>
      </view>
    </view>

    <!-- 我的赛事详情（可展开） -->
    <view class="detail-card card" wx:if="{{myMatches && myMatches.length > 0}}">
      <view class="card-title">我的赛事</view>
      <view class="match-list">
        <view 
          class="match-item" 
          wx:for="{{myMatches}}" 
          wx:key="id" 
          bindtap="onMyMatchTap" 
          data-id="{{item.id}}"
        >
          <view class="match-main">
            <view class="match-title">{{item.title}}</view>
            <view class="match-meta">
              <text class="match-date">{{item.date}}</text>
              <view class="match-status status-tag status-tag-primary">{{item.status}}</view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 我的俱乐部详情 -->
    <view class="detail-card card" wx:if="{{myClub}}">
      <view class="card-title">我的俱乐部</view>
      <view class="club-info">
        <view class="info-row">
          <text class="info-label">俱乐部名称</text>
          <text class="info-value">{{myClub.name}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">我的角色</text>
          <text class="info-value">{{myClub.role}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">加入时间</text>
          <text class="info-value">{{myClub.joinDate}}</text>
        </view>
      </view>
    </view>

  </view>
</view>