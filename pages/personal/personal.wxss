/* pages/personal/personal.wxss */

.page {
  min-height: 100vh;
  background-color: #F9FAFB;
}

.container {
  padding: 20rpx;
  box-sizing: border-box;
}

/* ========== 用户信息卡片 ========== */
.user-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 32rpx 24rpx;
  margin-bottom: 16rpx;
}

.user-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  flex-shrink: 0;
  border: 3rpx solid #F3F4F6;
}

.user-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.user-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #111827;
  line-height: 1.2;
}

.user-level {
  font-size: 26rpx;
  font-weight: 500;
}

.user-points {
  font-size: 24rpx;
  color: #6B7280;
}

/* ========== 功能菜单卡片 ========== */
.menu-card {
  margin-bottom: 16rpx;
  padding: 0;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  border-bottom: 1rpx solid #F3F4F6;
  transition: background-color 0.2s;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background-color: #F9FAFB;
}

.menu-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.menu-icon {
  font-size: 40rpx;
  width: 48rpx;
  text-align: center;
}

.menu-title {
  font-size: 32rpx;
  color: #111827;
  font-weight: 500;
}

.menu-arrow {
  font-size: 28rpx;
  color: #9CA3AF;
}

/* ========== 详情卡片 ========== */
.detail-card {
  margin-bottom: 16rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #111827;
  margin-bottom: 20rpx;
}

/* 赛事列表 */
.match-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.match-item {
  padding: 20rpx;
  background-color: #F9FAFB;
  border-radius: 12rpx;
  transition: all 0.2s;
}

.match-item:active {
  background-color: #F3F4F6;
  transform: scale(0.98);
}

.match-main {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.match-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #111827;
  line-height: 1.4;
}

.match-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.match-date {
  font-size: 24rpx;
  color: #6B7280;
}

.match-status {
  font-size: 22rpx;
}

/* 俱乐部信息 */
.club-info {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #F3F4F6;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 26rpx;
  color: #6B7280;
}

.info-value {
  font-size: 28rpx;
  color: #111827;
  font-weight: 500;
}

/* ========== 退出登录按钮 ========== */
.logout-card {
  margin-bottom: 16rpx;
  padding: 0;
}

.logout-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 28rpx 24rpx;
  transition: all 0.2s;
}

.logout-btn:active {
  background-color: #FEF2F2;
  transform: scale(0.98);
}

.logout-icon {
  font-size: 36rpx;
}

.logout-text {
  font-size: 32rpx;
  color: #EF4444;
  font-weight: 500;
}