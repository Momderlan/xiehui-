/* pages/member-apply/member-apply.wxss */

.page {
  min-height: 100vh;
  background-color: #F9FAFB;
  padding-bottom: 140rpx;
}

.container {
  padding: 20rpx;
  box-sizing: border-box;
}

/* ========== 表单卡片 ========== */
.form-card {
  padding: 32rpx 24rpx;
}

.form-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #111827;
  margin-bottom: 32rpx;
  text-align: center;
}

/* ========== 表单分组 ========== */
.form-section {
  margin-bottom: 32rpx;
}

.section-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #111827;
  margin-bottom: 16rpx;
}

/* ========== 选择器 ========== */
.picker-field {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  background-color: #F9FAFB;
  border-radius: 12rpx;
  border: 2rpx solid #E5E7EB;
}

.picker-value {
  font-size: 32rpx;
  color: #111827;
  font-weight: 500;
}

.picker-fee {
  font-size: 28rpx;
  color: #F97316;
  font-weight: 500;
}

/* ========== 表单提示 ========== */
.form-tips {
  margin-top: 24rpx;
  padding: 16rpx;
  background-color: #FEF3C7;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #92400E;
  text-align: center;
  line-height: 1.6;
}