<!--pages/member-apply/member-apply.wxml-->
<view class="page">
  <view class="container">

    <!-- 表单卡片 -->
    <view class="form-card card">
      <view class="form-title">会员申请</view>
      
      <!-- 会员等级选择 -->
      <view class="form-section">
        <view class="section-label">选择等级</view>
        <picker 
          mode="selector" 
          range="{{memberLevels}}" 
          range-key="name" 
          value="{{selectedLevel}}" 
          bindchange="onLevelChange"
        >
          <view class="picker-field">
            <text class="picker-value">{{memberLevels[selectedLevel].name}}</text>
            <text class="picker-fee">{{memberLevels[selectedLevel].fee}}</text>
          </view>
        </picker>
      </view>

      <!-- 基本信息 -->
      <view class="form-section">
        <view class="section-label">基本信息</view>
        <view class="form-group">
          <view class="form-label">姓名</view>
          <input 
            class="form-input" 
            type="text" 
            placeholder="请输入您的姓名" 
            value="{{formData.name}}" 
            bindinput="onInput" 
            data-field="name"
          />
        </view>
        <view class="form-group">
          <view class="form-label">手机号</view>
          <input 
            class="form-input" 
            type="number" 
            placeholder="请输入手机号码" 
            value="{{formData.phone}}" 
            bindinput="onInput" 
            data-field="phone"
          />
        </view>
        <view class="form-group">
          <view class="form-label">身份证号</view>
          <input 
            class="form-input" 
            type="idcard" 
            placeholder="请输入身份证号码" 
            value="{{formData.idCard}}" 
            bindinput="onInput" 
            data-field="idCard"
          />
        </view>
      </view>

      <!-- 补充信息 -->
      <view class="form-section">
        <view class="section-label">补充信息（选填）</view>
        <view class="form-group">
          <view class="form-label">详细地址</view>
          <textarea 
            class="form-textarea" 
            placeholder="请输入详细地址" 
            value="{{formData.address}}" 
            bindinput="onInput" 
            data-field="address"
          />
        </view>
      </view>

      <view class="form-tips">
        🔒 我们将对您的个人信息严格保密
      </view>
    </view>

  </view>

  <!-- 提交区：固定底部 -->
  <view class="fixed-bottom-bar">
    <button class="btn btn-primary" bindtap="onSubmit" style="width: 100%;">
      提交申请
    </button>
  </view>
</view>