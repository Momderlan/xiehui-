<!--pages/member/member.wxml-->
<view class="page">
  <view class="container">

    <!-- 核心信息：会员状态卡片 -->
    <view class="status-card card">
      <block wx:if="{{hasMember}}">
        <!-- 视觉锚点：会员等级 -->
        <view class="status-level" style="color: {{themeColor}}">{{memberInfo.level}}</view>
        <!-- 辅助信息 -->
        <view class="status-info">
          <view class="info-row">
            <text class="info-label">到期时间</text>
            <text class="info-value">{{memberInfo.expireDate}}</text>
          </view>
          <view class="info-row">
            <text class="info-label">会员积分</text>
            <text class="info-value">{{memberInfo.points}}</text>
          </view>
        </view>
      </block>
      <block wx:else>
        <view class="empty-status">
          <view class="empty-icon">👤</view>
          <view class="empty-title">您还不是会员</view>
          <view class="empty-desc">成为会员享受专属权益</view>
        </view>
      </block>
    </view>

    <!-- 说明信息：会员等级 -->
    <view class="level-card card">
      <view class="card-title">会员等级说明</view>
      <view class="level-list">
        <block wx:for="{{memberLevels}}" wx:key="id">
          <view class="level-item">
            <view class="level-header">
              <view class="level-name" style="color: {{themeColor}}">{{item.name}}</view>
              <view class="level-fee">{{item.fee}}</view>
            </view>
            <view class="benefit-list">
              <view class="benefit-item" wx:for="{{item.benefits}}" wx:for-item="benefit" wx:key="*this">
                <text class="benefit-dot">·</text>
                <text class="benefit-text">{{benefit}}</text>
              </view>
            </view>
          </view>
        </block>
      </view>
    </view>

  </view>

  <!-- 操作区：固定底部 - 单一主操作 -->
  <view class="fixed-bottom-bar">
    <button 
      class="btn btn-primary" 
      bindtap="onApplyTap"
      style="width: 100%;"
    >
      {{hasMember ? '续费会员' : '申请会员'}}
    </button>
    <button 
      wx:if="{{hasMember}}"
      class="btn-text" 
      bindtap="onViewInfoTap"
      style="width: 100%; margin-top: 8rpx;"
    >
      查看详情
    </button>
  </view>
</view>