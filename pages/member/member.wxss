/* pages/member/member.wxss */

.page {
  min-height: 100vh;
  background-color: #F9FAFB;
  padding-bottom: 140rpx;
}

.container {
  padding: 20rpx;
  box-sizing: border-box;
}

/* 核心信息：会员状态卡片 */
.status-card {
  margin-bottom: 16rpx;
  padding: 40rpx 32rpx;
  text-align: center;
}

/* 视觉锚点：会员等级 */
.status-level {
  font-size: 48rpx;
  font-weight: bold;
  margin-bottom: 32rpx;
  line-height: 1.2;
}

/* 辅助信息 */
.status-info {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #F3F4F6;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 26rpx;
  color: #6B7280;
}

.info-value {
  font-size: 32rpx;
  color: #111827;
  font-weight: 600;
}

/* 空状态 */
.empty-status {
  padding: 40rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
  opacity: 0.3;
}

.empty-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #111827;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 28rpx;
  color: #6B7280;
}

/* 说明信息：会员等级卡片 */
.level-card {
  margin-bottom: 16rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #111827;
  margin-bottom: 20rpx;
}

.level-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.level-item {
  padding: 24rpx;
  background: linear-gradient(135deg, #F97316 0%, #EA580C 100%);
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(249, 115, 22, 0.2);
}

.level-item:nth-child(2) {
  background: linear-gradient(135deg, #14B8A6 0%, #0D9488 100%);
  box-shadow: 0 4rpx 12rpx rgba(20, 184, 166, 0.2);
}

.level-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.2);
}

.level-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.level-fee {
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: 500;
}

.benefit-list {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.benefit-item {
  display: flex;
  align-items: flex-start;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.95);
  line-height: 1.6;
}

.benefit-dot {
  margin-right: 8rpx;
  flex-shrink: 0;
}

.benefit-text {
  flex: 1;
}