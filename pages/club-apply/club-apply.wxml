<!--pages/club-apply/club-apply.wxml-->
<view class="page">
  <view class="container">

    <!-- 表单卡片 -->
    <view class="form-card card">
      <view class="form-title">俱乐部申请</view>
      
      <!-- 基本信息 -->
      <view class="form-section">
        <view class="section-label">基本信息</view>
        <view class="form-group">
          <view class="form-label">俱乐部名称</view>
          <input 
            class="form-input" 
            type="text" 
            placeholder="请输入俱乐部名称" 
            value="{{formData.clubName}}" 
            bindinput="onInput" 
            data-field="clubName"
          />
        </view>
        <view class="form-group">
          <view class="form-label">负责人姓名</view>
          <input 
            class="form-input" 
            type="text" 
            placeholder="请输入负责人姓名" 
            value="{{formData.leaderName}}" 
            bindinput="onInput" 
            data-field="leaderName"
          />
        </view>
        <view class="form-group">
          <view class="form-label">联系电话</view>
          <input 
            class="form-input" 
            type="number" 
            placeholder="请输入联系电话" 
            value="{{formData.phone}}" 
            bindinput="onInput" 
            data-field="phone"
          />
        </view>
      </view>

      <!-- 俱乐部信息 -->
      <view class="form-section">
        <view class="section-label">俱乐部信息</view>
        <view class="form-group">
          <view class="form-label">成立时间</view>
          <picker 
            mode="date" 
            value="{{formData.foundDate}}" 
            bindchange="onDateChange"
          >
            <view class="picker-field">
              <text class="{{formData.foundDate ? 'picker-value' : 'picker-placeholder'}}">
                {{formData.foundDate || '请选择成立时间'}}
              </text>
            </view>
          </picker>
        </view>
        <view class="form-group">
          <view class="form-label">会员人数</view>
          <input 
            class="form-input" 
            type="number" 
            placeholder="请输入会员人数" 
            value="{{formData.memberCount}}" 
            bindinput="onInput" 
            data-field="memberCount"
          />
        </view>
        <view class="form-group">
          <view class="form-label">俱乐部地址</view>
          <textarea 
            class="form-textarea" 
            placeholder="请输入俱乐部详细地址" 
            value="{{formData.address}}" 
            bindinput="onInput" 
            data-field="address"
          />
        </view>
      </view>

      <!-- 补充说明 -->
      <view class="form-section">
        <view class="section-label">补充说明（选填）</view>
        <view class="form-group">
          <view class="form-label">俱乐部简介</view>
          <textarea 
            class="form-textarea" 
            placeholder="请简要介绍俱乐部的特色和优势" 
            value="{{formData.description}}" 
            bindinput="onInput" 
            data-field="description"
          />
        </view>
      </view>

      <view class="form-tips">
        📝 提交后我们将在3个工作日内审核
      </view>
    </view>

  </view>

  <!-- 提交区：固定底部 -->
  <view class="fixed-bottom-bar">
    <button class="btn btn-primary" bindtap="onSubmit" style="width: 100%;">
      提交申请
    </button>
  </view>
</view>