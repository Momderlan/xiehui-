<!--pages/login/login.wxml-->
<view class="login-container">
  <!-- Logo区域 -->
  <view class="logo-section">
    <image class="logo" src="/images/临时logo.png" mode="aspectFit"></image>
    <text class="app-name">乒乓球协会</text>
  </view>

  <!-- 登录表单 -->
  <view class="form-section" wx:if="{{isLoginMode}}">
    <view class="form-title">账号登录</view>
    
    <view class="form-item">
      <view class="form-label">用户名</view>
      <input 
        class="form-input" 
        placeholder="请输入用户名" 
        value="{{loginForm.username}}"
        data-field="username"
        bindinput="onLoginInput"
      />
    </view>

    <view class="form-item">
      <view class="form-label">密码</view>
      <input 
        class="form-input" 
        type="password"
        placeholder="请输入密码" 
        value="{{loginForm.password}}"
        data-field="password"
        bindinput="onLoginInput"
      />
    </view>

    <button class="submit-btn" bindtap="onLogin">登录</button>

    <view class="switch-mode">
      <text>还没有账号？</text>
      <text class="link" bindtap="toggleMode">立即注册</text>
    </view>
  </view>

  <!-- 注册表单 -->
  <view class="form-section" wx:else>
    <view class="form-title">用户注册</view>
    
    <view class="form-item">
      <view class="form-label">用户名 <text class="required">*</text></view>
      <input 
        class="form-input" 
        placeholder="请输入用户名（至少3个字符）" 
        value="{{registerForm.username}}"
        data-field="username"
        bindinput="onRegisterInput"
      />
    </view>

    <view class="form-item">
      <view class="form-label">密码 <text class="required">*</text></view>
      <input 
        class="form-input" 
        type="password"
        placeholder="请输入密码（至少6个字符）" 
        value="{{registerForm.password}}"
        data-field="password"
        bindinput="onRegisterInput"
      />
    </view>

    <view class="form-item">
      <view class="form-label">确认密码 <text class="required">*</text></view>
      <input 
        class="form-input" 
        type="password"
        placeholder="请再次输入密码" 
        value="{{registerForm.confirmPassword}}"
        data-field="confirmPassword"
        bindinput="onRegisterInput"
      />
    </view>

    <view class="form-item">
      <view class="form-label">手机号</view>
      <input 
        class="form-input" 
        type="number"
        placeholder="请输入手机号（可选）" 
        value="{{registerForm.phone}}"
        data-field="phone"
        bindinput="onRegisterInput"
      />
    </view>

    <view class="form-item">
      <view class="form-label">真实姓名</view>
      <input 
        class="form-input" 
        placeholder="请输入真实姓名（可选）" 
        value="{{registerForm.realName}}"
        data-field="realName"
        bindinput="onRegisterInput"
      />
    </view>

    <button class="submit-btn" bindtap="onRegister">注册</button>

    <view class="switch-mode">
      <text>已有账号？</text>
      <text class="link" bindtap="toggleMode">立即登录</text>
    </view>
  </view>

  <!-- 分隔线 -->
  <view class="divider">
    <view class="divider-line"></view>
    <text class="divider-text">或</text>
    <view class="divider-line"></view>
  </view>

  <!-- 微信登录按钮 -->
  <button class="wechat-login-btn" bindtap="onWechatLogin">
    <text class="wechat-icon">📱</text>
    <text>微信快捷登录</text>
  </button>

  <!-- 提示信息 -->
  <view class="tips">
    <text class="tips-text">登录即表示同意《用户协议》和《隐私政策》</text>
  </view>
</view>